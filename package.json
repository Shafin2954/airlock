{
  "name": "airlock-tools",
  "version": "0.1.0",
  "description": "Local-first tools for working with AI: redact secrets before you paste, map your codebase into a context window, explore huge JSONL logs. Nothing leaves your machine.",
  "license": "MIT",
  "bin": {
    "scrub": "scrub/cli.js",
    "airlock-scrub": "scrub/cli.js"
  },
  "main": "scrub/core.js",
  "files": [
    "scrub/core.js",
    "scrub/cli.js",
    "context-map/core.js",
    "jsonl-lens/core.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "e2e": "node tests/e2e.mjs",
    "serve": "npx --yes serve@14.2.6 ."
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "llm",
    "ai",
    "redact",
    "secrets",
    "pii",
    "claude-code",
    "context-window",
    "tokens",
    "jsonl",
    "privacy",
    "local-first"
  ]
}
